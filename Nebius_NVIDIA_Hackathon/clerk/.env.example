# Copy to .env and fill in. Never commit .env.
# offline = deterministic simulator (no keys needed); live = real Nemotron on Nebius Token Factory
CLERK_MODE=live

# Nebius Token Factory (https://tokenfactory.nebius.com) - OpenAI-compatible API
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Exact model IDs: run `make models` to list what your key can use.
CLERK_MODEL_SUPER=      # Nemotron 3 Super: Skeptic + Advocate (reasoning)
CLERK_MODEL_NANO=       # Nemotron Nano: Reader, AI Auditor, Ask (fast, cheap)
CLERK_MODEL_VISION=     # optional: a Nemotron model that accepts images (photos of bills)
CLERK_MODEL_EMBED=      # optional: an NVIDIA embedding model for the Vault

# Optional: USD per 1M tokens, from the Token Factory pricing page. Enables the cost meter.
CLERK_PRICE_SUPER_IN=
CLERK_PRICE_SUPER_OUT=
CLERK_PRICE_NANO_IN=
CLERK_PRICE_NANO_OUT=

# Tavily web research (https://tavily.com) - optional; without it the Researcher is skipped
TAVILY_API_KEY=

# Guardrails for the public demo: protect your credits during judging
CLERK_AUDITS_PER_HOUR=20
CLERK_DAILY_LLM_CALL_LIMIT=3000
CLERK_DB_PATH=clerk.db
